<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_shortcut_chip_row"
    android:paddingStart="6dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/avatar"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_shortcut_chip"
        android:gravity="center"
        android:textColor="@color/piko_text_primary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="2dp"
        android:maxWidth="64dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/piko_text_primary"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/btn_call"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="6dp"
        android:background="@drawable/bg_pressable"
        android:src="@drawable/ic_call" />

    <ImageButton
        android:id="@+id/btn_sms"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="6dp"
        android:background="@drawable/bg_pressable"
        android:src="@drawable/ic_sms" />

    <ImageButton
        android:id="@+id/btn_wa_message"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="6dp"
        android:background="@drawable/bg_pressable"
        android:src="@drawable/ic_message" />

    <ImageButton
        android:id="@+id/btn_wa_call"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="6dp"
        android:background="@drawable/bg_pressable"
        android:src="@drawable/ic_wa_call" />

</LinearLayout>
