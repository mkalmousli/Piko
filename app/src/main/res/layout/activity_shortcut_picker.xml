<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/piko_bg"
    android:paddingTop="36dp"
    android:paddingLeft="24dp"
    android:paddingRight="24dp">

    <TextView
        android:id="@+id/contact_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/piko_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/contact_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/piko_text_secondary"
        android:textSize="15sp" />

    <TextView
        style="@style/Piko.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Actions"
        android:textColor="@color/piko_accent" />

    <CheckBox android:id="@+id/check_call" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/action_call" android:textColor="@color/piko_text_primary" android:checked="true" />
    <CheckBox android:id="@+id/check_sms" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/action_message" android:textColor="@color/piko_text_primary" android:checked="true" />
    <CheckBox android:id="@+id/check_wa_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/action_whatsapp_message" android:textColor="@color/piko_text_primary" android:checked="true" />
    <CheckBox android:id="@+id/check_wa_call" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/action_whatsapp_call" android:textColor="@color/piko_text_primary" android:checked="true" />

    <TextView
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_search_bar"
        android:backgroundTint="@color/piko_accent"
        android:gravity="center"
        android:padding="14dp"
        android:text="Save shortcut"
        android:textColor="@color/piko_bg"
        android:textStyle="bold" />

</LinearLayout>
