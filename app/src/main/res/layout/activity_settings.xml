<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/piko_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/piko_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Piko.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_layout"
            android:textColor="@color/piko_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_columns"
                android:textColor="@color/piko_text_primary"
                android:textSize="15sp" />

            <ImageButton android:id="@+id/btn_columns_minus" style="@style/StepperButton" android:src="@drawable/ic_add" android:rotation="45" />
            <TextView android:id="@+id/text_columns" style="@style/StepperValue" />
            <ImageButton android:id="@+id/btn_columns_plus" style="@style/StepperButton" android:src="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_rows"
                android:textColor="@color/piko_text_primary"
                android:textSize="15sp" />

            <ImageButton android:id="@+id/btn_rows_minus" style="@style/StepperButton" android:src="@drawable/ic_add" android:rotation="45" />
            <TextView android:id="@+id/text_rows" style="@style/StepperValue" />
            <ImageButton android:id="@+id/btn_rows_plus" style="@style/StepperButton" android:src="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_pages"
                android:textColor="@color/piko_text_primary"
                android:textSize="15sp" />

            <ImageButton android:id="@+id/btn_pages_minus" style="@style/StepperButton" android:src="@drawable/ic_add" android:rotation="45" />
            <TextView android:id="@+id/text_pages" style="@style/StepperValue" />
            <ImageButton android:id="@+id/btn_pages_plus" style="@style/StepperButton" android:src="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_default_page"
                android:textColor="@color/piko_text_primary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_default_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_reset_layout"
            android:textColor="@color/piko_danger"
            android:background="@drawable/bg_pressable"
            android:padding="10dp"
            android:id="@+id/btn_reset_layout" />

        <TextView
            style="@style/Piko.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_behaviour"
            android:textColor="@color/piko_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_direct_call"
                android:textColor="@color/piko_text_primary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_direct_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical">

            <TextView
                style="@style/Piko.Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_shortcuts"
                android:textColor="@color/piko_accent" />

            <ImageButton
                android:id="@+id/btn_add_shortcut"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_pressable"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shortcuts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/text_no_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_no_shortcuts"
            android:textColor="@color/piko_text_hint"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
