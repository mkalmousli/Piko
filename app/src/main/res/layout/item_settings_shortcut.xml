<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_pressable"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/avatar"
        android:layout_width="@dimen/icon_size_dock"
        android:layout_height="@dimen/icon_size_dock"
        android:background="@drawable/bg_shortcut_chip"
        android:gravity="center"
        android:textColor="@color/piko_text_primary"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/piko_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/actions_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/piko_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_remove"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_pressable"
        android:src="@drawable/ic_add"
        android:rotation="45"
        android:contentDescription="@string/menu_remove" />

</LinearLayout>
